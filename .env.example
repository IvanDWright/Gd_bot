# Copia este archivo a ".env" y completa tus propios valores.
# El archivo ".env" NUNCA debe subirse a Git (ya esta en .gitignore).

# Discord Developer Portal -> tu aplicacion -> General Information
CLIENT_ID=tu_client_id_de_discord

# Discord Developer Portal -> tu aplicacion -> Bot -> Token
CLIENT_TOKEN=tu_token_de_bot_de_discord

# MongoDB Atlas -> Connect -> Drivers
# Ejemplo: mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/nombre_db?retryWrites=true&w=majority
MONGO_URI=tu_uri_de_mongodb
